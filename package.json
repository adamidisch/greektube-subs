{
  "name": "greektube-subs",
  "version": "7.8.32",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-greek-uppercase.mjs app public && node scripts/brand-cleanup.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "check:greek-uppercase": "node scripts/check-greek-uppercase.mjs app public",
    "test:caption-integrity": "node --experimental-strip-types scripts/caption-numeric-integrity.test.mjs",
    "test:caption-timing": "node --experimental-strip-types scripts/caption-timing.test.mjs",
    "test:caption-edgecases": "node --experimental-strip-types scripts/caption-translation-edgecases.test.mjs",
    "test:caption-quality-review": "node --experimental-strip-types scripts/caption-quality-review.test.mjs",
    "test:manual-captions": "node --experimental-strip-types scripts/manual-captions-parser.test.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@vercel/blob": "^2.8.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "GreekTube Subs"
}
