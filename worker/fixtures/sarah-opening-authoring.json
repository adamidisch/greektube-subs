  "phrases": [
    {
      "firstWordId": "W000001",
      "lastWordId": "W000006",
      "text": "Για την κόπωση ξεκινάμε,",
      "hardBreakBefore": false
    },
    {
      "firstWordId": "W000007",
      "lastWordId": "W000011",
      "text": "αφού οι υδατάνθρακες μάς κουράζουν,",
      "hardBreakBefore": false
    },
    {
      "firstWordId": "W000012",
      "lastWordId": "W000016",
      "text": "με κετογονική διατροφή.",
      "hardBreakBefore": false
    },
    {
      "firstWordId": "W000017",
      "lastWordId": "W000028",
      "text": "Πάντα ως βάση: διατροφή και λειτουργία εντέρου.",
      "hardBreakBefore": true
    },
    {
      "firstWordId": "W000029",
      "lastWordId": "W000035",
      "text": "Αν αυτά είναι εντάξει,",
      "hardBreakBefore": false
    },
    {
      "firstWordId": "W000036",
      "lastWordId": "W000041",
      "text": "εξετάζουμε τον θυρεοειδή.",
      "hardBreakBefore": false
    },
    {
      "firstWordId": "W000042",
      "lastWordId": "W000053",
      "text": "Ο υποθυρεοειδισμός δεν διαγιγνώσκεται μόνο με παθολογικές εξετάσεις αίματος.",
      "hardBreakBefore": true
    },
    {
      "firstWordId": "W000054",
      "lastWordId": "W000062",
      "text": "Αν είστε σε κέτωση αλλά νιώθετε χάλια,",
      "hardBreakBefore": true
    },
    {
      "firstWordId": "W000063",
      "lastWordId": "W000070",
      "text": "συχνά είναι ένδειξη υποθυρεοειδισμού.",
      "hardBreakBefore": false
    }
  ]
}
