AUDIO_TIMING_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BATCH_SIZE=8
WHISPER_LANGUAGE=en
POLL_SECONDS=5
LEASE_SECONDS=300
HEARTBEAT_SECONDS=30
MIN_DIRECT_ALIGNMENT_RATIO=0.70
MAX_UNALIGNED_RATIO=0.02
# Optional speaker diarization. The Hugging Face account must accept the model terms first.
HF_TOKEN=
# Optional fallback when YouTube requires authenticated cookies.
YTDLP_COOKIES_FILE=
